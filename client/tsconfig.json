{
    "extends": "../tsconfig.json",
    "include": [
        "src/**/*",
        "*.ts",
        "*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@shared/*": [
                "../shared/*"
            ],
            "@assets/*": [
                "../attached_assets/*"
            ]
        }
    }
}